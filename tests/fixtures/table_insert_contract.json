{
 "about": "Operations the Writer client emits for table insertion and typed Markdown tables. tests_ts/table_insert.test.ts checks the client produces exactly these; tests/test_table_insert_contract.py applies them to a real DocumentSession and checks the resulting block order, persistence and undo.",
 "scenarios": [
  {
   "name": "caret at the start of the first paragraph puts the table first",
   "action": "insertTable",
   "rows": 2,
   "columns": 3,
   "blocks": [
    {
     "id": "p1",
     "type": "paragraph",
     "text": "First"
    },
    {
     "id": "p2",
     "type": "paragraph",
     "text": "Second"
    }
   ],
   "point": {
    "selection": {
     "start": {
      "block": "p1",
      "offset": 0,
      "field": "text"
     },
     "end": {
      "block": "p1",
      "offset": 0,
      "field": "text"
     },
     "collapsed": true
    },
    "object": null
   },
   "newIds": [
    "tbl"
   ],
   "ops": [
    {
     "op": "batch",
     "ops": [
      {
       "op": "block_insert",
       "after": null,
       "block": {
        "id": "tbl",
        "type": "table",
        "text": "",
        "rows": 2,
        "columns": 3
       }
      }
     ],
     "label": "insert table"
    }
   ],
   "order": [
    "tbl",
    "p1",
    "p2"
   ]
  },
