{
  "name": "slai-writer",
  "version": "1.0.0",
  "private": true,
  "description": "SLAI Writer: a local-first document editor for SLDC documents (browser client)",
  "type": "module",
  "scripts": {
    "build": "node ../tools/build/build-static.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests_ts/*.test.ts",
    "test:compiled": "tsc -p tsconfig.test.json && node --test .test-out/slai_writer/tests_ts/*.test.js",
    "test:e2e": "node tests_e2e/run.mjs",
    "test:py": "python3 -m unittest discover -s tests -t ../.. -v"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
